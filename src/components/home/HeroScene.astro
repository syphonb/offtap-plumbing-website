---
import { getImage } from "astro:assets";
import lion from "../../assets/lion-listening.png";
const image = await getImage({ src: lion, width: 384, format: "webp" });
---

<div class="stage" aria-hidden="true">
  <svg viewBox="0 0 640 380" fill="none" focusable="false">
    <defs>
      <linearGradient id="soil" x1="0" y1="0" x2="0" y2="1"
        ><stop offset="0" stop-color="#0E2633"></stop><stop
          offset="1"
          stop-color="#0C151C"></stop></linearGradient
      >
      <pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse"
        ><circle cx="2" cy="2" r="1" fill="#1d4459"></circle></pattern
      >
      <linearGradient id="roof" x1="0" x2="1"
        ><stop offset="0" stop-color="#ffc79e"></stop><stop
          offset="1"
          stop-color="#e0662c"></stop></linearGradient
      >
      <radialGradient id="leakglow"
        ><stop offset="0" stop-color="#F28E52" stop-opacity=".55"></stop><stop
          offset="1"
          stop-color="#F28E52"
          stop-opacity="0"></stop></radialGradient
      >
    </defs>
    <rect y="200" width="640" height="180" fill="url(#soil)"></rect>
    <rect y="200" width="640" height="180" fill="url(#dots)" opacity=".7"
    ></rect>
    <line x1="0" y1="200" x2="640" y2="200" stroke="#2f6f8c" stroke-width="1.5"
    ></line>
    <g stroke="#2a5d6e" stroke-width="1.2"
      ><path
        d="M30 200l3-6M36 200l2-5M140 200l3-6M146 200l2-5M260 200l3-6M590 200l3-6M596 200l2-5"
      ></path></g
    >
    <g stroke="#4f7d92" stroke-width="1.6">
      <path d="M330 200V108l110-62 110 62v92" fill="#0f1f2a"></path>
      <path d="M318 112 440 40l122 72" stroke="url(#roof)" stroke-width="2.4"
      ></path>
      <rect x="470" y="140" width="40" height="60" fill="#0C151C"></rect>
      <rect x="360" y="124" width="46" height="36" fill="#0C151C"></rect>
      <line x1="383" y1="124" x2="383" y2="160"></line><line
        x1="360"
        y1="142"
        x2="406"
        y2="142"></line>
    </g>
    <rect
      x="322"
      y="200"
      width="236"
      height="16"
      fill="#163646"
      stroke="#4f7d92"
      stroke-width="1.2"></rect>
    <g stroke="#26505f" stroke-width="1"
      ><path
        d="M340 204l8 8M380 204l8 8M420 204l8 8M460 204l8 8M500 204l8 8M540 204l8 8"
      ></path></g
    >
    <rect
      x="46"
      y="190"
      width="34"
      height="20"
      rx="3"
      fill="#0f1f2a"
      stroke="#4f7d92"
      stroke-width="1.5"></rect>
    <circle cx="63" cy="200" r="5" stroke="#7fd4f7" stroke-width="1.5"></circle>
    <path
      class="pipe"
      d="M80 205 H110 Q120 205 120 215 V255 Q120 265 130 265 H420 Q430 265 430 255 V150 H470"
    ></path>
    <path class="pipe" d="M200 265 V300 H260"></path>
    <path
      class="flow"
      d="M80 205 H110 Q120 205 120 215 V255 Q120 265 130 265 H420 Q430 265 430 255 V150 H470"
    ></path>
    <path class="flow" d="M200 265 V300 H260"></path>
    <circle cx="380" cy="265" r="34" fill="url(#leakglow)"></circle>
    <circle class="leak-ring" cx="380" cy="265" r="12"></circle>
    <circle
      cx="380"
      cy="265"
      r="7"
      fill="#F28E52"
      stroke="#ffd3b5"
      stroke-width="2"></circle>
    <g
      font-family="Space Grotesk, sans-serif"
      font-size="10"
      fill="#91a6b1"
      letter-spacing="1.5"
    >
      <text x="40" y="232">METER</text><text x="196" y="330">YARD SERVICE</text
      ><text x="482" y="134">WALL</text>
    </g>
    <text
      x="356"
      y="296"
      font-family="Space Grotesk, sans-serif"
      font-size="10"
      font-weight="600"
      fill="#F28E52"
      letter-spacing="1.5">LEAK · UNDER SLAB</text
    >
    <g
      class="listen"
      stroke="#00A9ED"
      stroke-width="1.6"
      fill="none"
      stroke-linecap="round"
    >
      <path d="M238 214a14 14 0 0 0 24 0"></path><path
        d="M230 222a24 24 0 0 0 40 0"></path><path d="M222 230a34 34 0 0 0 56 0"
      ></path>
    </g>
    <image
      class="lion"
      href={image.src}
      x="230"
      y="15"
      width="124"
      height="189"
    />
  </svg>
</div>
